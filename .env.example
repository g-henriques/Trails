# Copy to .env on the NAS, fill in, then: chmod 600 .env. NEVER commit .env.
# Guide: docs/instalacao-nas.md.

# --- NAS: rede ---------------------------------------------------------------
# Porta no browser: http://<ip-da-nas>:<NAS_PORT>. Tem de estar livre (ver inventário da NAS).
NAS_PORT=8094
# IP fixo da NAS na rede local (ex. 192.168.1.50). 0.0.0.0 = todas as interfaces.
NAS_BIND_IP=0.0.0.0

# --- NAS: pastas, backups e atualizações -------------------------------------
NAS_DATA_DIR=./data
NAS_BACKUP_DIR=./backups
NAS_BACKUP_KEEP=14
# Ramo do GitHub que a NAS segue
NAS_BRANCH=main
# trails:local = construir na NAS; ghcr.io/g-henriques/trails:latest = descarregar do GitHub
NAS_IMAGE=trails:local
# Imagem privada no GHCR: ficheiro com um token só com read:packages (chmod 600), numa pasta
# partilhada, porque a QNAP apaga /root (e o login do docker) a cada reinício. Vazio = sem login.
NAS_GHCR_TOKEN_FILE=
NAS_GHCR_USER=g-henriques
# Deploy key só de leitura (repositório privado), fora de /root. Vazio = repositório público.
NAS_SSH_KEY=
TZ=Europe/Lisbon

# --- App ---------------------------------------------------------------------
# (variáveis da própria app; podem ter espaços: os scripts deploy/ não as leem)
# Horas entre recolhas completas (listas + traçados GPX). 168 = uma vez por semana; 0 = só manual
# (botão "Atualizar" no topo do site).
TRAILS_SCRAPE_INTERVAL_HOURS=168
# Segundos entre pedidos ao mesmo site (o OpenStreetMap pede uso moderado; não baixe de 1).
TRAILS_REQUEST_DELAY=1
# Servidores Overpass (descobrem trilhos que não estão nas listas), separados por vírgulas.
# Vazio = servidores públicos (overpass-api.de, kumi.systems, private.coffee); off = desligar.
# TRAILS_OVERPASS_URLS=
# Tolerância (metros) ao simplificar os traçados guardados; 0 guarda todos os pontos do OSM.
TRAILS_SIMPLIFY_METERS=2
